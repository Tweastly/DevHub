{
	# Certificates for project subdomains are issued on first visit,
	# only if DevHub confirms the subdomain belongs to a project.
	on_demand_tls {
		ask http://devhub:8080/_caddy/ask
	}
}

{$DEVHUB_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	reverse_proxy devhub:8080
}

*.{$DEVHUB_DOMAIN} {
	tls {
		on_demand
	}
	reverse_proxy devhub:8080
}
