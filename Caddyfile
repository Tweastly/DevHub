{
	# Certificates for project hosts are issued on first visit,
	# only if DevHub confirms the host belongs to a project.
	on_demand_tls {
		ask http://devhub:8080/_caddy/ask
	}
}

{$DEVHUB_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	reverse_proxy devhub:8080
}

# Everything else: project subdomains (*.{$DEVHUB_DOMAIN}) and custom domains
# added in DevHub (e.g. new.tweastly.com). DevHub routes them by Host header.
https:// {
	tls {
		on_demand
	}
	reverse_proxy devhub:8080
}
