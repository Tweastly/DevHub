{
	# Certificates for project hosts are issued on first visit,
	# only if DevHub confirms the host belongs to a project.
	on_demand_tls {
		ask http://devhub:8080/_caddy/ask
	}
}

{$DEVHUB_DOMAIN} {
	# Compress pages, but never the live SSE streams (compression would buffer them).
	encode {
		zstd
		gzip
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type application/json*
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	reverse_proxy devhub:8080 {
		flush_interval -1
	}
}

# Project subdomains: one wildcard certificate, or one per project (see these files).
import projects-{$DEVHUB_TLS:ondemand}.caddy

# Everything else: project subdomains (*.{$DEVHUB_DOMAIN}) and custom domains
# added in DevHub (e.g. new.tweastly.com). DevHub routes them by Host header.
https:// {
	tls {
		on_demand
	}
	reverse_proxy devhub:8080
}
