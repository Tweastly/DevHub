# Caddy runs inside DevHub's container, on the server's network, started by DevHub
# (src/caddy.rs), which sets DEVHUB_UPSTREAM to its own address (127.0.0.1:8080).
{
	# Nothing to reconfigure at runtime: no admin endpoint on the server's network.
	admin off
	# Its local authority stays in its storage: no system trust store in a container.
	skip_install_trust
	# HTTP_PORT in the .env if port 80 is taken (certificates then go through 443).
	http_port {$HTTP_PORT:80}
	# Certificates for project hosts are issued on first visit,
	# only if DevHub confirms the host belongs to a project.
	on_demand_tls {
		ask http://{$DEVHUB_UPSTREAM}/_caddy/ask
	}
}

# If DevHub doesn't answer (it is starting), a small page that reloads itself
# instead of an empty 502.
(restarting) {
	handle_errors 502 503 504 {
		root * /etc/caddy
		rewrite * /restarting.html
		header Cache-Control no-store
		header Retry-After 5
		file_server {
			status 503
		}
	}
}

{$DEVHUB_DOMAIN} {
	# Compress pages, but never the live SSE streams (compression would buffer them).
	encode {
		zstd
		gzip
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type application/json*
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	reverse_proxy {$DEVHUB_UPSTREAM} {
		flush_interval -1
	}
	import restarting
}

# Project subdomains: one wildcard certificate, or one per project (see these files).
import projects-{$DEVHUB_TLS:ondemand}.caddy

# Everything else: project subdomains (*.{$DEVHUB_DOMAIN}) and custom domains
# added in DevHub (e.g. app.example.com). DevHub routes them by Host header.
https:// {
	tls {
		on_demand
	}
	reverse_proxy {$DEVHUB_UPSTREAM}
	import restarting
}
