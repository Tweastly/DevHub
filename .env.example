# Copie ce fichier en .env sur le serveur. Ne commite jamais .env : il est dans .gitignore.
DEVHUB_DOMAIN=dev.example.com

# Dépôt privé : jeton GitHub fine-grained, Contents en lecture seule (mises à jour).
# DEVHUB_GITHUB_TOKEN=

# Certificat wildcard *.DEVHUB_DOMAIN par le DNS Cloudflare (jeton Zone → DNS → Modifier).
# DEVHUB_TLS=wildcard
# CLOUDFLARE_API_TOKEN=

# Port HTTP s'il est déjà pris (les certificats passent alors par le 443).
# HTTP_PORT=80
